# Copy this to .env and adjust values.

# Database -------------------------------------------------------------------
# Local dev (SQLite): file:./dev.db
# Production: postgresql://USER:PASS@HOST:5432/dawrak?schema=public&sslmode=require
DATABASE_URL="file:./dev.db"

# Public site URL ------------------------------------------------------------
# Used in generated QR codes and server-rendered links.
# In production, set this to your deployment origin (e.g. https://dawrak.app).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auth.js v5 secret ----------------------------------------------------------
# Generate one with: npx auth secret
# REQUIRED in production. Length must be at least 32 random hex chars.
AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"

# Cron / scheduled jobs ------------------------------------------------------
# External schedulers must hit /api/cron/* with ?token=$CRON_SECRET to run
# cleanup, daily reset, and data-retention jobs. Leave unset to disable.
CRON_SECRET="replace-me-with-a-16-byte-hex-secret"

# Optional: error reporting --------------------------------------------------
# When set, Sentry is initialized in instrumentation.ts.
# SENTRY_DSN="https://xxx@oXX.ingest.sentry.io/XXX"

# Optional: SMS provider for call-up notifications ---------------------------
# Values: none | log | unifonic | twilio
# - "none" disables SMS entirely (Web Push only).
# - "log" prints messages to stdout (useful in dev).
SMS_PROVIDER="none"
# SMS_API_KEY=""
# SMS_SENDER_ID="Dawrak"
