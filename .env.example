# Copy this to .env and adjust values.

# Database -------------------------------------------------------------------
# PostgreSQL (production) ----------------------------------------------------
# Pooled connection used by the app (supports connection pooling via pgBouncer).
# If using Prisma Postgres / Vercel Postgres, copy the "Prisma Accelerate"
# or pooled connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Direct (non-pooled) connection for Prisma Migrate and `prisma db push`.
# Required in production. If using Prisma Postgres, copy the "Direct URL" here.
# DANGER: Never expose this in client-side code.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Local dev (SQLite) ----------------------------------------------------------
# If you want to keep SQLite for local dev, temporarily switch
# prisma/schema.prisma back to provider = "sqlite" and use:
#   DATABASE_URL="file:./dev.db"
#   DIRECT_URL=""
#

# Public site URL ------------------------------------------------------------
# Must match your production domain, e.g. https://dawrak.vercel.app
# Used in generated QR codes, sitemap, and server-rendered links.
NEXT_PUBLIC_BASE_URL="https://dawrak.vercel.app"

# Auth.js v5 secret ----------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 32
# Set this in Vercel Dashboard → Settings → Environment Variables.
AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"

# Cron / scheduled jobs ------------------------------------------------------
# Vercel Cron hits /api/cron/* automatically with an Authorization header.
# Any long random string works here.
CRON_SECRET="replace-me-with-a-16-byte-hex-secret"

# Optional: error reporting --------------------------------------------------
# SENTRY_DSN="https://xxx@oXX.ingest.sentry.io/XXX"

# Optional: SMS provider for call-up notifications ---------------------------
# Values: none | log | unifonic | twilio
# "none" disables SMS entirely. "log" prints to stdout (good for dev).
SMS_PROVIDER="none"
