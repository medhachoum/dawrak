# ── Dawrak Environment Variable Reference ─────────────────────────────────────
# Copy this to `.env.local` for local dev.
# Production secrets MUST be added in Vercel Dashboard → Project →
# Settings → Environment Variables. NEVER commit real credentials to git.
# ────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma Postgres) ──────────────────────────────────────────────
# Prisma Postgres provides this automatically under Project → Storage.
# It is a **pooled** connection that works with Prisma Client out of the box
# (pgBouncer-compatible).
DATABASE_URL=""

# ── Public site URL ──────────────────────────────────────────────────────────
# Must match your production domain exactly (no trailing slash).
# On Vercel with a custom domain: https://dawrak.app
# On the default Vercel subdomain: https://dawrak.vercel.app
NEXT_PUBLIC_BASE_URL="https://dawrak.vercel.app"

# ── Auth.js v5 secret ───────────────────────────────────────────────────────
# REQUIRED. Used to sign session JWTs and hash tokens.
# Generate fresh with:  openssl rand -base64 32
# Paste the exact string below or directly in Vercel Dashboard.
AUTH_SECRET="REPLACE-ME"

# ── Auth URL (optional in v5, auto-detected from headers) ─────────────────────
# Only needed if your app is behind a reverse proxy that strips the Host header.
# AUTH_URL="https://dawrak.vercel.app"

# ── Cron / scheduled jobs ─────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer <token>` automatically,
# and external schedulers can use `?token=`. Any long random string works.
# Generate fresh with:  openssl rand -base64 24
CRON_SECRET="REPLACE-ME"

# ── Optional: error reporting (Sentry) ─────────────────────────────────────────
# Uncomment and set when you install @sentry/nextjs.
# SENTRY_DSN=""

# ── Optional: SMS provider for call-up notifications ────────────────────────
# Values: none | log | unifonic | twilio
# "none" disables SMS. "log" prints to stdout (good for dev).
SMS_PROVIDER="none"
# SMS_API_KEY=""
# SMS_SENDER_ID="Dawrak"
