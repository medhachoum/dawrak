# Copy this to .env.local for local dev. NEVER commit real secrets.
# Production secrets go in Vercel Dashboard → Project → Settings → Environment Variables.
# ────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL) ──────────────────────────────────────────────────────
# Prisma Postgres / Neon / Vercel Postgres pooled connection string.
# In production, Vercel provides this automatically if linked to a Postgres project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Public site URL ──────────────────────────────────────────────────────────
# Must match your production domain.
# Locally: http://localhost:3000
# On Vercel: your-project-name.vercel.app or your custom domain.
NEXT_PUBLIC_BASE_URL="https://your-project-name.vercel.app"

# Auth.js v5 secret ─────────────────────────────────────────────────────────
# REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or: openssl rand -base64 32
AUTH_SECRET="REPLACE-ME-❌-DO-NOT-COMMIT"

# Cron / scheduled jobs ─────────────────────────────────────────────────────
# Any long random string. Vercel Cron sends Authorization: Bearer <token> automatically.
CRON_SECRET="REPLACE-ME-❌-DO-NOT-COMMIT"

# Optional: error reporting ─────────────────────────────────────────────────
# SENTRY_DSN="https://xxx@oXX.ingest.sentry.io/XXX"

# Optional: SMS provider for call-up notifications ──────────────────────────
# Values: none | log | unifonic | twilio
# "none" disables SMS entirely. "log" prints to stdout (good for dev).
SMS_PROVIDER="none"
# SMS_API_KEY=""
# SMS_SENDER_ID="Dawrak"
